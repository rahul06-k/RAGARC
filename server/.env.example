# App Configuration
APP_NAME=CollegeAI Assistant
APP_ENV=development
PORT=8000
DEBUG=True

# Database Configuration (Defaults to SQLite for instant local run, supports PostgreSQL)
DATABASE_URL=sqlite:///./college_rag.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_rag

# JWT Security
SECRET_KEY=college-rag-super-secret-jwt-key-2026-production-ready-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Supported providers: 'gemini', 'openai', 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL_NAME=gemini-1.5-flash

# Embeddings Configuration
# Supported: 'sentence_transformers', 'gemini', 'openai'
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=college_documents

# Document Upload & Ingestion
UPLOAD_DIR=./uploaded_documents
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
